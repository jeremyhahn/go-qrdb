{
	"name": "go-qrdb",
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspace/go-qrdb",
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go"
			],
			"settings": {
				"go.testFlags": ["-v", "-race", "-count=1"],
				"go.lintTool": "golangci-lint",
				"go.lintFlags": ["--timeout=5m"]
			}
		}
	},
	"capAdd": ["NET_ADMIN", "IPC_LOCK"],
	"remoteUser": "root"
}
