# Copy to .devcontainer/.env (gitignored) to give docker compose
# (.devcontainer/docker-compose.yml) machine-local values. Leave the file
# absent and every build and run uses the public proxy and no dev cache.
#
# No address belongs in a tracked file: `make check-public-releasable`
# rejects internal addresses anywhere in the tree.

# Fleet dev-cache passthrough (devops.md §2a); empty means no cache.
DEVCACHE_GOPROXY=
