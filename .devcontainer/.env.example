# Copy to .devcontainer/.env (gitignored) on a machine that resolves the
# first-party github.com/jeremyhahn/* modules from a private Go module forge
# instead of the public proxy. Leave the file absent to use the public proxy.
#
# Both the Makefile (stage-gomodauth, for every docker build of
# .devcontainer/Dockerfile) and docker compose (.devcontainer/docker-compose.yml)
# read this file. An exported variable of the same name wins over it.
#
# Neither value belongs in a tracked file: `make check-public-releasable`
# rejects the forge's address anywhere in the tree.

# host:port of the forge that serves the first-party modules over HTTP.
GITEA_HOST=forge.example.com:3000

# A read-only access token for that forge.
GITEA_GO_TOKEN=
