# Binaries. These must stay anchored: an unanchored `qrdb` matches at any
# depth and matches directories, which silently excluded the whole of
# cmd/qrdb/ and cmd/qrdbd/ from the repository.
bin/
/qrdb
/qrdbd
*.exe
*.test
*.out

# Coverage
coverage/

# Logs
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript SDK
sdk/typescript/node_modules/
sdk/typescript/dist/

# Frontend
cmd/qrdb/frontend/node_modules/
cmd/qrdb/frontend/dist/

# Wails generated bindings
cmd/qrdb/frontend/src/lib/wails/

.serena
.claude
CLAUDE.md
go.work
go.work.sum

# compiled binaries never enter the module tree
cmd/qrdb-sqlite/qrdb-sqlite
/bin/

# devcontainer secrets (Gitea module-fetch token)
.devcontainer/.env

# CI security-scan reports (devops.md §8)
gosec.sarif
trivy-results.sarif

# Runtime state a locally-run daemon leaves behind, including its issued
# keys and certificates. Previously covered only as collateral of the
# unanchored `qrdbd` pattern above.
cmd/qrdbd/data/

# Web UI bundle, produced by `make webui` and consumed by the qrdbd_webui
# build tag.
cmd/qrdbd/webui_dist/

# A literal `~` directory, created when a tool expanded a home-relative path
# inside the repository instead of the shell doing it.
/~/
